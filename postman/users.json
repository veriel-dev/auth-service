{
  "info": {
    "_postman_id": "unique-id",
    "name": "User Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Database Seed",
      "item": [
        {
          "name": "Seed Database",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/seed"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"newuser@example.com\",\n    \"password\": \"Password123!\",\n    \"firstName\": \"New\",\n    \"lastName\": \"User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users",
            "query": [
              {
                "key": "page",
                "value": "1"
              },
              {
                "key": "limit",
                "value": "10"
              },
              {
                "key": "search",
                "value": ""
              }
            ]
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/{{userId}}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/users/{{userId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"Updated\",\n    \"lastName\": \"Name\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Soft Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/users/{{userId}}"
          }
        },
        {
          "name": "Update Password",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/users/{{userId}}/password",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"currentPassword\": \"OldPass123!\",\n    \"newPassword\": \"NewPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users/{{userId}}/verify-email/{{token}}"
          }
        },
        {
          "name": "Update Status",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/users/{{userId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"isActive\": false,\n    \"reason\": \"Account deactivated by user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ]
}
